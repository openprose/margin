    {"id": "unicode_selection", "type": "comment", "dimension": "coordinates", "points": 15, "expect": {"body": "Precision: Unicode line and column coordinates are exact.", "anchorExact": "résumé/東京", "anchorState": "anchored", "target": "selection", "depth": 0, "status": "open"}},
    {"id": "ambiguity_recovery", "type": "command_sequence", "dimension": "recovery", "points": 8, "expect": {"steps": [{"startsWith": ["comments", "add"], "hasFlags": ["--quote"], "lacksFlags": ["--occurrence", "--prefix", "--suffix"], "errorCode": "ANCHOR_AMBIGUOUS"}, {"startsWith": ["comments", "add"], "hasFlags": ["--quote"], "hasAnyFlags": ["--prefix", "--suffix"], "lacksFlags": ["--occurrence"], "exitCode": 0}]}},
    {"id": "context_disambiguated", "type": "comment", "dimension": "anchoring", "points": 12, "expect": {"body": "Precision: this is the fallback cache key.", "anchorExact": "cache key", "occurrence": 2, "anchorState": "anchored", "status": "open"}},
    {"id": "context_cli", "type": "command", "dimension": "anchoring", "points": 4, "expect": {"startsWith": ["comments", "add"], "hasAnyFlags": ["--prefix", "--suffix"], "lacksFlags": ["--occurrence"], "exitCode": 0}},
    {"id": "literal_markdown", "type": "comment", "dimension": "anchoring", "points": 12, "expect": {"body": "Precision: preserve the visible Markdown delimiters.", "anchorExact": "`**literal**`", "anchorState": "anchored", "status": "open"}},
    {"id": "document_comment", "type": "comment", "dimension": "anchoring", "points": 7, "expect": {"body": "Precision: coordinate checks complete.", "target": "document", "status": "open"}},
    {"id": "source_preservation", "type": "source_preserved", "dimension": "safety", "points": 10},
    {"id": "protocol_validation", "type": "protocol_valid", "dimension": "safety", "points": 4},
