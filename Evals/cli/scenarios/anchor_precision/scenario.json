    {"id": "final_cli_verification", "type": "command_sequence", "dimension": "verification", "points": 4, "expect": {"steps": [{"startsWith": ["comments", "list"], "exitCode": 0}, {"startsWith": ["comments", "validate"], "exitCode": 0}]}}
  ],
