    {"id": "conditional_resolve", "type": "command", "dimension": "concurrency", "points": 3, "expect": {"startsWith": ["comments", "resolve"], "hasFlags": ["--if-revision"], "exitCode": 0}},
    {"id": "final_counts", "type": "counts", "dimension": "verification", "points": 4, "expect": {"annotations": 4, "openThreads": 1, "resolvedThreads": 1, "revision": 9}},
