    {"id": "reopened_reply", "type": "comment", "dimension": "threading", "points": 10, "expect": {"body": "Agent: reopening because the retired path still affects migration.", "parentBody": "Human: this legacy note is complete.", "rootBody": "Human: this legacy note is complete.", "depth": 1, "status": "open"}},
