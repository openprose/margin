{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:prime-study-completion:v1",
  "title": "MarginBench completed paired Prime study receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "completed", "paidModelsInvoked", "planID", "jobCount",
    "observedWalletDebitUSD", "traceReportedCostUSD", "modelCalls", "allSafe",
    "allSourcePreserved", "submissionID", "diagnostic", "verified", "output"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:prime-study-completion:v1"},
    "completed": {"const": true},
    "paidModelsInvoked": {"const": true},
    "planID": {"$ref": "#/$defs/prefixedSha256"},
    "jobCount": {"type": "integer", "minimum": 2, "maximum": 1000},
    "observedWalletDebitUSD": {"type": "number", "minimum": 0},
    "proxyAccountedCostUpperBoundUSD": {"type": "number", "minimum": 0},
    "walletObservationScope": {"const": "account-wide"},
    "walletDebitAttribution": {"const": "unattributed"},
    "traceReportedCostUSD": {"type": "number", "minimum": 0},
    "modelCalls": {"type": "integer", "minimum": 0},
    "allSafe": {"type": "boolean"},
    "allSourcePreserved": {"type": "boolean"},
    "submissionID": {"$ref": "#/$defs/prefixedSha256"},
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "topOpportunity"],
      "properties": {
        "path": {"const": "diagnostic.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topOpportunity": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "verified": {"const": true},
    "output": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "dependentRequired": {
    "proxyAccountedCostUpperBoundUSD": [
      "walletObservationScope", "walletDebitAttribution"
    ],
    "walletObservationScope": [
      "proxyAccountedCostUpperBoundUSD", "walletDebitAttribution"
    ],
    "walletDebitAttribution": [
      "proxyAccountedCostUpperBoundUSD", "walletObservationScope"
    ]
  },
  "$defs": {
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
