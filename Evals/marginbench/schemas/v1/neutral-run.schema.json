{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:neutral-run:v1",
  "title": "MarginBench non-scalar plain-control run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "runID", "status", "track", "scalarRankingPermitted",
    "benchmark", "candidate", "execution", "episodes", "cost", "privacy"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:neutral-run:v1"},
    "runID": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "status": {"enum": ["completed", "infrastructure-error"]},
    "track": {"const": "representation"},
    "scalarRankingPermitted": {"const": false},
    "benchmark": {"$ref": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json#/properties/benchmark"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "execution": {"$ref": "#/$defs/execution"},
    "episodes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/episode"}
    },
    "cost": {"$ref": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json#/properties/cost"},
    "privacy": {"$ref": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json#/properties/privacy"}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "controlImplementationSha256", "durableSurface", "toolSurface"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "controlImplementationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "durableSurface": {"const": "plain-markdown-files"},
        "toolSurface": {"const": ["workspace"]}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "adapter", "provider", "model", "harness", "runtime", "controlProfile",
        "marginBinaryUsed", "agentProcessCount", "roles", "traceSeats", "phasePolicy",
        "startedAt", "durationMs", "limits", "retryPolicy", "priorInfrastructureAttempts"
      ],
      "properties": {
        "adapter": {"const": "prime-verifiers-v1"},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "harness": {"const": "null-with-one-workspace-tool"},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 256},
        "controlProfile": {"const": "role-separated-plain-markdown-v1"},
        "marginBinaryUsed": {"const": false},
        "agentProcessCount": {"type": "integer", "minimum": 1, "maximum": 200},
        "roles": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "traceSeats": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "phasePolicy": {"const": "scenario-defined"},
        "startedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "number", "minimum": 0, "maximum": 86400000},
        "limits": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}
        },
        "retryPolicy": {"type": "string", "minLength": 1, "maxLength": 512},
        "priorInfrastructureAttempts": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "modelCalls", "promptTokens", "completionTokens", "cachedInputTokens",
        "reasoningTokens", "reportedCostUSD"
      ],
      "properties": {
        "modelCalls": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "promptTokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "completionTokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "cachedInputTokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "reasoningTokens": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "reportedCostUSD": {"type": "number", "minimum": 0, "maximum": 1000000}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": [
        "count", "failedCount", "invalidCount", "requestBytes", "responseBytes",
        "cumulativeToolTimeMs", "measurementBasis"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "failedCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "invalidCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "requestBytes": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "responseBytes": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "cumulativeToolTimeMs": {"type": "number", "minimum": 0, "maximum": 86400000},
        "measurementBasis": {"const": "served-workspace-tool-boundary"}
      }
    },
    "stopCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "count": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "scenario", "fingerprint", "repetition", "implementedChecksPassed",
        "safetyPassed", "sourcePreserved", "durationMs", "checks", "dimensions",
        "toolRoundTrips", "stopConditions", "usage", "controlProfile", "logicalActors",
        "agentProcessCount", "traceSeats", "phasePolicy"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 512},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 128},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repetition": {"type": "integer", "minimum": 0, "maximum": 99},
        "implementedChecksPassed": {"type": "boolean"},
        "safetyPassed": {"type": "boolean"},
        "sourcePreserved": {"type": "boolean"},
        "durationMs": {"type": "number", "minimum": 0, "maximum": 3600000},
        "checks": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "boolean"}
        },
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome", "integrity", "attribution", "continuity", "recovery"],
          "properties": {
            "outcome": {"type": "number", "minimum": 0, "maximum": 100},
            "integrity": {"type": "number", "minimum": 0, "maximum": 100},
            "attribution": {"type": "number", "minimum": 0, "maximum": 100},
            "continuity": {"type": "number", "minimum": 0, "maximum": 100},
            "recovery": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "toolRoundTrips": {"$ref": "#/$defs/tool"},
        "stopConditions": {
          "type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/stopCondition"}
        },
        "usage": {"$ref": "#/$defs/usage"},
        "controlProfile": {"const": "role-separated-plain-markdown-v1"},
        "logicalActors": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json#/$defs/logicalActor"}
        },
        "agentProcessCount": {"type": "integer", "minimum": 1, "maximum": 32},
        "traceSeats": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "phasePolicy": {"const": "scenario-defined"}
      }
    }
  }
}
