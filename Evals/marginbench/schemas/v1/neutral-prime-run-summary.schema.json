{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:neutral-prime-run-summary:v1",
  "title": "MarginBench redacted Prime plain-control execution summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "paidModelsInvoked", "model", "candidate", "controlProfile",
    "controlImplementationSha256", "marginBinaryUsed", "scalarRankingPermitted",
    "scenarios", "repetitions", "durationMs", "exitCode", "wallet",
    "estimatedMaximumCostUSD", "infrastructureCodes", "traceCount", "episodeCount",
    "traceConsistencyPassed", "episodes", "rawTracesCommitted"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:neutral-prime-run-summary:v1"},
    "status": {"enum": ["completed", "infrastructure_error"]},
    "paidModelsInvoked": {"type": "boolean"},
    "model": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {"type": "string", "minLength": 1, "maxLength": 256},
    "controlProfile": {"const": "role-separated-plain-markdown-v1"},
    "controlImplementationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "marginBinaryUsed": {"const": false},
    "scalarRankingPermitted": {"const": false},
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "durationMs": {"type": "number", "minimum": 0, "maximum": 86400000},
    "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
    "wallet": {"$ref": "urn:marginbench:prime-run-summary:v1#/properties/wallet"},
    "estimatedMaximumCostUSD": {"type": "number", "minimum": 0, "maximum": 1000000},
    "contractMaximumCostUSD": {"type": "number", "minimum": 0, "maximum": 1000000},
    "liveBudgetCapUSD": {"type": "number", "minimum": 0, "maximum": 1000000},
    "costBoundBasis": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}
    },
    "liveBudget": {"$ref": "urn:marginbench:prime-run-summary:v1#/$defs/liveBudget"},
    "infrastructureCodes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "traceCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "episodeCount": {"type": "integer", "minimum": 0, "maximum": 1000},
    "traceConsistencyPassed": {"type": "boolean"},
    "episodes": {
      "type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/episode"}
    },
    "rawTracesCommitted": {"const": false}
  },
  "dependentRequired": {
    "contractMaximumCostUSD": ["liveBudgetCapUSD", "liveBudget", "costBoundBasis"],
    "liveBudgetCapUSD": ["contractMaximumCostUSD", "liveBudget", "costBoundBasis"],
    "liveBudget": ["contractMaximumCostUSD", "liveBudgetCapUSD", "costBoundBasis"]
  },
  "$defs": {
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": [
        "episodeID", "scenario", "repetition", "fingerprint", "implementedChecksPassed",
        "safetyPassed", "sourcePreserved", "durationMs", "checks", "dimensions",
        "efficiencyObservations", "controlProfile", "logicalActors", "agentProcessCount",
        "traceSeats", "phasePolicy", "roleRuns", "usage"
      ],
      "properties": {
        "episodeID": {"type": "string", "minLength": 1, "maxLength": 512},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 128},
        "repetition": {"type": "integer", "minimum": 0, "maximum": 99},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "implementedChecksPassed": {"type": "boolean"},
        "safetyPassed": {"type": "boolean"},
        "sourcePreserved": {"type": "boolean"},
        "durationMs": {"type": "number", "minimum": 0, "maximum": 3600000},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome", "integrity", "attribution", "continuity", "recovery"],
          "properties": {
            "outcome": {"type": "number", "minimum": 0, "maximum": 100},
            "integrity": {"type": "number", "minimum": 0, "maximum": 100},
            "attribution": {"type": "number", "minimum": 0, "maximum": 100},
            "continuity": {"type": "number", "minimum": 0, "maximum": 100},
            "recovery": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "efficiencyObservations": {"$ref": "#/$defs/efficiencyObservations"},
        "controlProfile": {"const": "role-separated-plain-markdown-v1"},
        "logicalActors": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "urn:marginbench:prime-run-summary:v1#/$defs/logicalActor"}
        },
        "agentProcessCount": {"type": "integer", "minimum": 1, "maximum": 32},
        "traceSeats": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "phasePolicy": {"const": "scenario-defined"},
        "roleRuns": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "urn:marginbench:prime-run-summary:v1#/$defs/roleRun"}
        },
        "usage": {"$ref": "urn:marginbench:prime-run-summary:v1#/$defs/usage"}
      }
    },
    "efficiencyObservations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "toolCallCount", "failedToolCallCount", "requestByteCount",
        "responseByteCount", "toolDurationMicroseconds", "actionCounts",
        "modelCallCount", "inputTokenCount", "outputTokenCount", "costUSD", "scalarScore"
      ],
      "properties": {
        "toolCallCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "failedToolCallCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "requestByteCount": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "responseByteCount": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "toolDurationMicroseconds": {"type": "integer", "minimum": 0, "maximum": 600000000000},
        "actionCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["guide", "list", "read", "write", "invalid"],
          "properties": {
            "guide": {"type": "integer", "minimum": 0, "maximum": 10000},
            "list": {"type": "integer", "minimum": 0, "maximum": 10000},
            "read": {"type": "integer", "minimum": 0, "maximum": 10000},
            "write": {"type": "integer", "minimum": 0, "maximum": 10000},
            "invalid": {"type": "integer", "minimum": 0, "maximum": 10000}
          }
        },
        "modelCallCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "inputTokenCount": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "outputTokenCount": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "costUSD": {"const": null},
        "scalarScore": {"const": null}
      }
    }
  }
}
