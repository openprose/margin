{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json",
  "title": "MarginBench redacted run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runID", "status", "track", "benchmark", "candidate", "execution", "episodes", "cost", "privacy"],
  "properties": {
    "schema": {"const": "urn:marginbench:run:v1"},
    "runID": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"type": "string", "enum": ["completed", "infrastructure-error", "invalid"]},
    "track": {"type": "string", "enum": ["model", "interface", "team", "open-systems"]},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "taskSet", "developmentCases"],
      "properties": {
        "name": {"const": "MarginBench"},
        "version": {"type": "string", "minLength": 1},
        "taskSet": {"type": "string", "minLength": 1},
        "developmentCases": {"type": "boolean"},
        "implementationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marginSha256", "manualSha256", "settingsSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "marginSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manualSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "settingsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "provider", "model", "harness", "runtime", "roles", "startedAt", "durationMs", "limits", "retryPolicy", "priorInfrastructureAttempts"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "controlProfile": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "startedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "number", "minimum": 0},
        "limits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}},
        "retryPolicy": {"type": "string", "minLength": 1},
        "priorInfrastructureAttempts": {"type": "integer", "minimum": 0}
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "fingerprint", "repetition", "score", "safetyPassed", "commandCount", "invalidCommandCount", "checks", "dimensions", "usage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "repetition": {"type": "integer", "minimum": 0},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "safetyPassed": {"type": "boolean"},
          "commandCount": {"type": "integer", "minimum": 0},
          "invalidCommandCount": {"type": "integer", "minimum": 0},
          "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "dimensions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modelCalls", "promptTokens", "completionTokens", "cachedInputTokens", "reasoningTokens", "reportedCostUSD"],
            "properties": {
              "modelCalls": {"type": "integer", "minimum": 0},
              "promptTokens": {"type": "integer", "minimum": 0},
              "completionTokens": {"type": "integer", "minimum": 0},
              "cachedInputTokens": {"type": "integer", "minimum": 0},
              "reasoningTokens": {"type": "integer", "minimum": 0},
              "reportedCostUSD": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "traceReported", "observedWalletDebit", "unreconciled"],
      "properties": {
        "currency": {"const": "USD"},
        "traceReported": {"type": "number", "minimum": 0},
        "observedWalletDebit": {"type": "number", "minimum": 0},
        "unreconciled": {"type": "number", "minimum": 0},
        "admissionBound": {"type": "number", "minimum": 0},
        "hardAdmissionCap": {"type": "number", "exclusiveMinimum": 0},
        "boundBasis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokenCeilingPerCall",
            "outputTokenCeilingPerCall",
            "modelCallsPerAgentAtMost",
            "upstreamAttemptsPerTurnAtMost",
            "inputPricePerMillion",
            "outputPricePerMillion",
            "billingOverheadUSDPerCall"
          ],
          "properties": {
            "inputTokenCeilingPerCall": {"type": "integer", "minimum": 1},
            "outputTokenCeilingPerCall": {"type": "integer", "minimum": 1},
            "modelCallsPerAgentAtMost": {"type": "integer", "minimum": 1},
            "upstreamAttemptsPerTurnAtMost": {"type": "integer", "minimum": 1},
            "inputPricePerMillion": {"type": "number", "minimum": 0},
            "outputPricePerMillion": {"type": "number", "minimum": 0},
            "billingOverheadUSDPerCall": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTracesPublished", "credentialsPresent", "promptsPublished", "holdoutKeyPublished"],
      "properties": {
        "rawTracesPublished": {"const": false},
        "credentialsPresent": {"const": false},
        "promptsPublished": {"type": "boolean"},
        "holdoutKeyPublished": {"type": "boolean"}
      }
    }
  }
}
