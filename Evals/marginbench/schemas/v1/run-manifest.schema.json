{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margin.tools/schemas/marginbench/v1/run-manifest.schema.json",
  "title": "MarginBench redacted run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runID", "status", "track", "benchmark", "candidate", "execution", "episodes", "cost", "privacy"],
  "properties": {
    "schema": {"const": "urn:marginbench:run:v1"},
    "runID": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"type": "string", "enum": ["completed", "infrastructure-error", "invalid"]},
    "track": {"type": "string", "enum": ["model", "interface", "team", "open-systems", "representation"]},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "taskSet", "developmentCases"],
      "properties": {
        "name": {"const": "MarginBench"},
        "version": {"type": "string", "minLength": 1},
        "taskSet": {"type": "string", "minLength": 1},
        "developmentCases": {"type": "boolean"},
        "implementationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marginSha256", "manualSha256", "settingsSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "marginSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manualSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "settingsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "provider", "model", "harness", "runtime", "roles", "startedAt", "durationMs", "limits", "retryPolicy", "priorInfrastructureAttempts"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "controlProfile": {"type": "string", "minLength": 1},
        "agentProcessCount": {"type": "integer", "minimum": 1},
        "roles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "traceSeats": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "phasePolicy": {"enum": ["scenario-defined", "serial-stable-role-order", "independent-workspaces"]},
        "startedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "number", "minimum": 0},
        "limits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}},
        "retryPolicy": {"type": "string", "minLength": 1},
        "priorInfrastructureAttempts": {"type": "integer", "minimum": 0}
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "fingerprint", "repetition", "score", "safetyPassed", "commandCount", "invalidCommandCount", "checks", "dimensions", "usage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "repetition": {"type": "integer", "minimum": 0},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "safetyPassed": {"type": "boolean"},
          "sourcePreserved": {"type": "boolean"},
          "commandCount": {"type": "integer", "minimum": 0},
          "invalidCommandCount": {"type": "integer", "minimum": 0},
          "durationMs": {"type": "number", "minimum": 0},
          "marginSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "dimensions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
          "stopConditions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "count"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 128},
                "count": {"type": "integer", "minimum": 1, "maximum": 128}
              }
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modelCalls", "promptTokens", "completionTokens", "cachedInputTokens", "reasoningTokens", "reportedCostUSD"],
            "properties": {
              "modelCalls": {"type": "integer", "minimum": 0},
              "promptTokens": {"type": "integer", "minimum": 0},
              "completionTokens": {"type": "integer", "minimum": 0},
              "cachedInputTokens": {"type": "integer", "minimum": 0},
              "reasoningTokens": {"type": "integer", "minimum": 0},
              "reportedCostUSD": {"type": "number", "minimum": 0}
            }
          },
          "controlProfile": {"type": "string", "minLength": 1, "maxLength": 256},
          "logicalActors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/logicalActor"}},
          "agentProcessCount": {"type": "integer", "minimum": 1, "maximum": 32},
          "traceSeats": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "phasePolicy": {"enum": ["scenario-defined", "serial-stable-role-order", "independent-workspaces"]}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "traceReported", "observedWalletDebit", "unreconciled"],
      "properties": {
        "currency": {"const": "USD"},
        "traceReported": {"type": "number", "minimum": 0},
        "observedWalletDebit": {"type": "number", "minimum": 0},
        "unreconciled": {"type": "number", "minimum": 0},
        "admissionBound": {"type": "number", "minimum": 0},
        "contractBound": {"type": "number", "minimum": 0},
        "liveBudgetCap": {"type": "number", "exclusiveMinimum": 0},
        "hardAdmissionCap": {"type": "number", "exclusiveMinimum": 0},
        "liveBudget": {"$ref": "#/$defs/liveBudget"},
        "boundBasis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokenCeilingPerCall",
            "outputTokenCeilingPerCall",
            "modelCallsPerAgentAtMost",
            "upstreamAttemptsPerTurnAtMost",
            "inputPricePerMillion",
            "outputPricePerMillion",
            "billingOverheadUSDPerCall"
          ],
          "properties": {
            "inputTokenCeilingPerCall": {"type": "integer", "minimum": 1},
            "outputTokenCeilingPerCall": {"type": "integer", "minimum": 1},
            "modelCallsPerAgentAtMost": {"type": "integer", "minimum": 1},
            "upstreamAttemptsPerTurnAtMost": {"type": "integer", "minimum": 1},
            "inputPricePerMillion": {"type": "number", "minimum": 0},
            "outputPricePerMillion": {"type": "number", "minimum": 0},
            "billingOverheadUSDPerCall": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTracesPublished", "credentialsPresent", "promptsPublished", "holdoutKeyPublished"],
      "properties": {
        "rawTracesPublished": {"const": false},
        "credentialsPresent": {"const": false},
        "promptsPublished": {"type": "boolean"},
        "holdoutKeyPublished": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "logicalActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "phase", "id", "name", "type"],
      "properties": {
        "seat": {"type": "string", "minLength": 1, "maxLength": 128},
        "phase": {"type": "integer", "minimum": 0, "maximum": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 2048},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "type": {"enum": ["person", "software", "organization"]}
      }
    },
    "liveBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "forwardedRequestCount", "rejectedRequestCount",
        "reservedCostUpperBoundUSD", "reportedPromptTokens",
        "reportedCompletionTokens", "reportedTokenCostUSD", "policy"
      ],
      "properties": {
        "enabled": {"const": true},
        "forwardedRequestCount": {"type": "integer", "minimum": 0},
        "rejectedRequestCount": {"type": "integer", "minimum": 0},
        "reservedCostUpperBoundUSD": {"type": "number", "minimum": 0},
        "grossReservedCostUpperBoundUSD": {"type": "number", "minimum": 0},
        "settledRequestCount": {"type": "integer", "minimum": 0},
        "outstandingReservationCount": {"type": "integer", "minimum": 0},
        "reportedPromptTokens": {"type": "integer", "minimum": 0},
        "reportedCompletionTokens": {"type": "integer", "minimum": 0},
        "reportedTokenCostUSD": {"type": "number", "minimum": 0},
        "providerBoundViolationCount": {"type": "integer", "minimum": 0},
        "latchedClosed": {"type": "boolean"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedModel", "maxRequestBytes", "templateTokenAllowance",
            "inputTokenCeiling", "maxOutputTokens",
            "inputPricePerMillion", "outputPricePerMillion",
            "billingOverheadUSDPerCall", "maxTotalCostUSD"
          ],
          "properties": {
            "allowedModel": {"type": "string", "minLength": 1, "maxLength": 512},
            "maxRequestBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
            "templateTokenAllowance": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "inputTokenCeiling": {"type": "integer", "minimum": 1, "maximum": 4000000},
            "maxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "responseTokenAllowance": {"type": "integer", "minimum": 0, "maximum": 4096},
            "inputPricePerMillion": {"type": "number", "minimum": 0},
            "outputPricePerMillion": {"type": "number", "minimum": 0},
            "billingOverheadUSDPerCall": {"type": "number", "minimum": 0},
            "maxTotalCostUSD": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  }
}
