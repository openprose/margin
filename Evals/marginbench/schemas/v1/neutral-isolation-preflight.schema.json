{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:neutral-isolation-preflight:v1",
  "title": "MarginBench plain-control transcript-isolation preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "passed", "paidModelsInvoked", "controlProfile", "controlRunnable",
    "marginBinaryUsed", "modelEndpoint", "executionBoundary", "toolSurface",
    "rawPromptsRetained", "rawTranscriptsRetained", "scenarioCount",
    "repetitionCount", "episodeCount", "roleProcessCount", "distinctRolePromptCount",
    "fakeModelRequestCount", "ownCanaryEchoCount", "ownCanaryMissingCount",
    "crossRoleCanaryLeakCount", "malformedRequestCount", "durationMs", "episodes"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:neutral-isolation-preflight:v1"},
    "passed": {"type": "boolean"},
    "paidModelsInvoked": {"const": false},
    "controlProfile": {"const": "role-separated-plain-markdown-v1"},
    "controlRunnable": {"const": true},
    "marginBinaryUsed": {"const": false},
    "modelEndpoint": {"const": "loopback-scripted-openai-compatible"},
    "executionBoundary": {"const": "fresh-subprocess-rollout-per-role"},
    "toolSurface": {"const": ["workspace"]},
    "rawPromptsRetained": {"const": false},
    "rawTranscriptsRetained": {"const": false},
    "scenarioCount": {"type": "integer", "minimum": 1, "maximum": 9},
    "repetitionCount": {"type": "integer", "minimum": 1, "maximum": 5},
    "episodeCount": {"type": "integer", "minimum": 1, "maximum": 45},
    "roleProcessCount": {"type": "integer", "minimum": 1, "maximum": 90},
    "distinctRolePromptCount": {"type": "integer", "minimum": 1, "maximum": 90},
    "fakeModelRequestCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "ownCanaryEchoCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "ownCanaryMissingCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "crossRoleCanaryLeakCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "malformedRequestCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "durationMs": {"type": "number", "minimum": 0, "maximum": 3600000},
    "episodes": {
      "type": "array", "minItems": 1, "maxItems": 45,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["episodeID", "scenario", "repetition", "roleProcessCount", "passed"],
        "properties": {
          "episodeID": {"type": "string", "minLength": 1, "maxLength": 512},
          "scenario": {
            "enum": [
              "human_agent_relay", "agent_agent_handoff", "concurrent_review",
              "suggestion_decision", "staged_multifile", "directory_handoff",
              "parallel_shards", "specialist_audit", "distributed_synthesis"
            ]
          },
          "repetition": {"type": "integer", "minimum": 0, "maximum": 4},
          "roleProcessCount": {"type": "integer", "minimum": 1, "maximum": 2},
          "passed": {"type": "boolean"}
        }
      }
    }
  }
}
