{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:neutral-feasibility:v1",
  "title": "MarginBench no-model neutral-control feasibility receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "paidModelsInvoked", "controlProfile", "controlRunnable",
    "implementedChecksPassed", "scenarioCount", "assessmentCount", "notEvaluated",
    "assessments"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:neutral-feasibility:v1"},
    "paidModelsInvoked": {"const": false},
    "controlProfile": {"const": "role-separated-plain-markdown-v1"},
    "controlRunnable": {"const": true},
    "implementedChecksPassed": {"type": "boolean"},
    "scenarioCount": {"type": "integer", "minimum": 1, "maximum": 9},
    "assessmentCount": {"type": "integer", "minimum": 1, "maximum": 900},
    "notEvaluated": {"const": ["efficiency"]},
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 900,
      "items": {"$ref": "urn:marginbench:neutral-assessment:v1"}
    }
  }
}
