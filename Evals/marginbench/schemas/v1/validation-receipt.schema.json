{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:validation:v1",
  "title": "MarginBench bounded artifact validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "valid", "artifactSchema", "sha256", "byteCount", "error", "errors"],
  "properties": {
    "schema": {"const": "urn:marginbench:validation:v1"},
    "valid": {"type": "boolean"},
    "artifactSchema": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "byteCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1, "maxLength": 128},
            "message": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        }
      ]
    },
    "errors": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"valid": {"const": true}}},
      "then": {
        "properties": {
          "artifactSchema": {"type": "string"},
          "sha256": {"type": "string"},
          "byteCount": {"type": "integer"},
          "error": {"type": "null"},
          "errors": {"maxItems": 0}
        }
      },
      "else": {"properties": {"error": {"type": "object"}}}
    }
  ]
}
