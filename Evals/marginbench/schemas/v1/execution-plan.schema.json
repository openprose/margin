{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:execution-plan:v1",
  "title": "MarginBench deterministic paired execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "benchmarkVersion", "taskSet", "developmentCases",
    "controlProfile", "studyPlanSha256", "baselineCandidate", "candidate",
    "episodeCount", "jobCount", "roleProcessCount", "failurePolicy", "jobs"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:execution-plan:v1"},
    "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "benchmarkVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "taskSet": {"type": "string", "minLength": 1, "maxLength": 256},
    "developmentCases": {"type": "boolean"},
    "controlProfile": {"type": "string", "minLength": 1, "maxLength": 256},
    "studyPlanSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baselineCandidate": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidate": {"type": "string", "minLength": 1, "maxLength": 256},
    "episodeCount": {"type": "integer", "minimum": 1, "maximum": 500},
    "jobCount": {"type": "integer", "minimum": 2, "maximum": 1000},
    "roleProcessCount": {"type": "integer", "minimum": 2, "maximum": 32000},
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continueAfterIncompleteJob", "retryCreatesNewRun", "completedJobReplay"],
      "properties": {
        "continueAfterIncompleteJob": {"const": false},
        "retryCreatesNewRun": {"const": true},
        "completedJobReplay": {"const": "verify-and-skip"}
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal", "id", "episodeID", "scenario", "repetition", "fingerprint",
          "candidateID", "candidatePosition", "roles"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 999},
          "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "episodeID": {"type": "string", "minLength": 1, "maxLength": 512},
          "scenario": {"type": "string", "minLength": 1, "maxLength": 256},
          "repetition": {"type": "integer", "minimum": 0, "maximum": 99},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "candidateID": {"type": "string", "minLength": 1, "maxLength": 256},
          "candidatePosition": {"type": "integer", "minimum": 0, "maximum": 1},
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    }
  }
}
