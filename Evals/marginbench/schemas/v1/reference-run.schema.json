{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:reference-run:v1",
  "title": "MarginBench no-model reference run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "paidModelsInvoked", "passed", "results"],
  "properties": {
    "schema": {"const": "urn:marginbench:reference-run:v1"},
    "paidModelsInvoked": {"const": false},
    "passed": {"type": "boolean"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://margin.tools/schemas/marginbench/v1/result.schema.json"}
    }
  }
}
