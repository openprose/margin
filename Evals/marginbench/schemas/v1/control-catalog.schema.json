{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:control-catalog:v1",
  "title": "MarginBench control profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "default", "profiles", "rules"],
  "properties": {
    "schema": {"const": "urn:marginbench:control-catalog:v1"},
    "default": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "implemented"}}},
            "then": {"properties": {"blockingGates": {"maxItems": 0}}},
            "else": {"properties": {"blockingGates": {"minItems": 1}}}
          }
        ],
        "required": [
          "id", "status", "agentTopology", "transcriptSharing", "durableSurface",
          "toolSurface", "shellAccess", "isolationRequirement", "scoreComparability", "purpose",
          "blockingGates"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["implemented", "specified-not-runnable"]},
          "agentTopology": {"type": "string", "minLength": 1},
          "transcriptSharing": {"type": "string", "minLength": 1},
          "durableSurface": {"type": "string", "minLength": 1},
          "toolSurface": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "shellAccess": {"type": "boolean"},
          "isolationRequirement": {"type": "string", "minLength": 1},
          "scoreComparability": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "blockingGates": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "requirement"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "requirement": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
