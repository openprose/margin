{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:prime-study-progress:v1",
  "title": "MarginBench paired Prime study progress receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "planID", "completedJobs", "jobCount", "lastJobID",
    "observedWalletDebitUSD"
  ],
  "properties": {
    "schema": {"const": "urn:marginbench:prime-study-progress:v1"},
    "planID": {"$ref": "#/$defs/prefixedSha256"},
    "completedJobs": {"type": "integer", "minimum": 1, "maximum": 1000},
    "jobCount": {"type": "integer", "minimum": 2, "maximum": 1000},
    "lastJobID": {"$ref": "#/$defs/prefixedSha256"},
    "observedWalletDebitUSD": {"type": "number", "minimum": 0},
    "proxyAccountedCostUpperBoundUSD": {"type": "number", "minimum": 0},
    "walletObservationScope": {"const": "account-wide"},
    "walletDebitAttribution": {"const": "unattributed"},
    "status": {"const": "paused"},
    "paidModelsInvoked": {"const": true},
    "nextOrdinal": {"type": "integer", "minimum": 1, "maximum": 999},
    "automaticRetryPerformed": {"const": false}
  },
  "dependentRequired": {
    "status": ["paidModelsInvoked", "nextOrdinal", "automaticRetryPerformed"],
    "proxyAccountedCostUpperBoundUSD": [
      "walletObservationScope", "walletDebitAttribution"
    ],
    "walletObservationScope": [
      "proxyAccountedCostUpperBoundUSD", "walletDebitAttribution"
    ],
    "walletDebitAttribution": [
      "proxyAccountedCostUpperBoundUSD", "walletObservationScope"
    ]
  },
  "$defs": {
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
