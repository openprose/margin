{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginbench:schema:suggestion-convergence-probe:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "paidModelsInvoked", "passed", "fixture", "method", "arms", "comparison"],
  "properties": {
    "schema": {"const": "urn:marginbench:suggestion-convergence-probe:v1"},
    "version": {"const": 1},
    "paidModelsInvoked": {"const": false},
    "passed": {"type": "boolean"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseSetSha256", "sampleCountPerArm", "firstRepetition"],
      "properties": {
        "caseSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sampleCountPerArm": {"type": "integer", "minimum": 2, "maximum": 800},
        "firstRepetition": {"const": 0}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitionsPerDelay", "delaysMs", "pollIntervalMs", "waitTimeoutSeconds",
        "knownSuggestionIDCount", "pairedConcurrentStart", "counterbalancedSubmissionOrder",
        "verificationCallsExcluded"
      ],
      "properties": {
        "repetitionsPerDelay": {"type": "integer", "minimum": 2, "maximum": 100},
        "delaysMs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 100, "maximum": 2000}
        },
        "pollIntervalMs": {"type": "integer", "minimum": 10, "maximum": 500},
        "waitTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "knownSuggestionIDCount": {"const": 2},
        "pairedConcurrentStart": {"const": true},
        "counterbalancedSubmissionOrder": {"const": true},
        "verificationCallsExcluded": {"const": true}
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate"],
      "properties": {
        "baseline": {"$ref": "#/$defs/arm"},
        "candidate": {"$ref": "#/$defs/arm"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateMinusBaselineConvergenceCalls", "candidateToBaselineConvergenceCallRatio", "byDelay"],
      "properties": {
        "candidateMinusBaselineConvergenceCalls": {"type": "integer"},
        "candidateToBaselineConvergenceCallRatio": {"type": "number", "exclusiveMinimum": 0},
        "byDelay": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["delayMs", "candidateMinusBaselineMedianCalls", "candidateMinusBaselineMedianDurationMs"],
            "properties": {
              "delayMs": {"type": "integer", "minimum": 100, "maximum": 2000},
              "candidateMinusBaselineMedianCalls": {"type": "number"},
              "candidateMinusBaselineMedianDurationMs": {"type": "number"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "numericSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "median", "p95", "max"],
      "properties": {
        "min": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "callSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "min", "median", "p95", "max", "histogram"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "min": {"type": "number", "minimum": 1},
        "median": {"type": "number", "minimum": 1},
        "p95": {"type": "number", "minimum": 1},
        "max": {"type": "number", "minimum": 1},
        "histogram": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {"pattern": "^[1-9][0-9]*$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "delaySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delayMs", "sampleCount", "convergenceCalls", "durationMs"],
      "properties": {
        "delayMs": {"type": "integer", "minimum": 100, "maximum": 2000},
        "sampleCount": {"type": "integer", "minimum": 2, "maximum": 100},
        "convergenceCalls": {"$ref": "#/$defs/callSummary"},
        "durationMs": {"$ref": "#/$defs/numericSummary"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binarySha256", "sampleCount", "completedCount", "writerFailureCount",
        "convergenceFailureCount", "documentValid", "graphIntegrityPassed",
        "sourcePreserved", "convergenceCalls", "durationMs", "byDelay"
      ],
      "properties": {
        "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sampleCount": {"type": "integer", "minimum": 2, "maximum": 800},
        "completedCount": {"type": "integer", "minimum": 0, "maximum": 800},
        "writerFailureCount": {"type": "integer", "minimum": 0, "maximum": 800},
        "convergenceFailureCount": {"type": "integer", "minimum": 0, "maximum": 800},
        "documentValid": {"type": "boolean"},
        "graphIntegrityPassed": {"type": "boolean"},
        "sourcePreserved": {"type": "boolean"},
        "convergenceCalls": {"$ref": "#/$defs/callSummary"},
        "durationMs": {"$ref": "#/$defs/numericSummary"},
        "byDelay": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/delaySummary"}
        }
      }
    }
  }
}
