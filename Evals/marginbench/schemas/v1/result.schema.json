{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margin.tools/schemas/marginbench/v1/result.schema.json",
  "title": "MarginBench episode result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "episode_id", "candidate_id", "score", "dimensions", "checks", "command_count", "invalid_command_count", "duration_ms", "safety_passed", "source_preserved", "margin_sha256", "events"],
  "properties": {
    "schema": {"const": "urn:marginbench:result:v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "dimensions": {
      "type": "object",
      "required": ["outcome", "integrity", "protocol", "recovery", "efficiency"],
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
    },
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "command_count": {"type": "integer", "minimum": 0},
    "invalid_command_count": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "number", "minimum": 0},
    "safety_passed": {"type": "boolean"},
    "source_preserved": {"type": "boolean"},
    "margin_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events": {"type": "array", "items": {"$ref": "command-event.schema.json"}}
  }
}
